<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LosMobileView" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Application colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryDark</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:windowBackground">@color/backgroundGray</item>
        <item name="android:textColorPrimary">@color/textBlack</item>
    </style>

    <style name="Theme.LosMobileView" parent="Base.Theme.LosMobileView" />

    <!-- Custom button style like los-mobile -->
    <style name="LosButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

</resources>